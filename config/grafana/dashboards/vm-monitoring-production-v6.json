        "w": 8,
        "x": 8,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "kvo-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (namespace, service) (rate(node_disk_read_bytes_total{device!~\"loop.*|ram.*\", namespace=~\"$namespace\", service=~\"$service\", service=~\".*-metrics\"}[5m]))",
          "legendFormat": "read {{namespace}} / {{service}}",
          "refId": "A"
        },
        {
          "expr": "sum by (namespace, service) (rate(node_disk_written_bytes_total{device!~\"loop.*|ram.*\", namespace=~\"$namespace\", service=~\"$service\", service=~\".*-metrics\"}[5m]))",
          "legendFormat": "write {{namespace}} / {{service}}",
          "refId": "B"
        }
