        "type": "prometheus",
        "uid": "kvo-prometheus"
      },
      "targets": [
        {
          "expr": "windows_service_state{state=\"running\", namespace=~\"$namespace\", service=~\"$service\", service=~\".*-metrics\"}",
          "legendFormat": "{{namespace}} / {{service}} / {{name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 1
        }
      }
    },
    {
