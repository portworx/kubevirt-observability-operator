          "refId": "A",
          "format": "table",
          "instant": true
        },
        {
          "expr": "topk(15, 1000 * (rate(windows_logical_disk_write_seconds_total{volume!~\"HarddiskVolume.*\", namespace=~\"$namespace\", service=~\"$service\", service=~\".*-metrics\"}[5m]) / rate(windows_logical_disk_writes_total{volume!~\"HarddiskVolume.*\", namespace=~\"$namespace\", service=~\"$service\", service=~\".*-metrics\"}[5m])))",
          "refId": "B",
          "format": "table",
