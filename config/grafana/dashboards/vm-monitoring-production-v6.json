        {
          "expr": "rate(node_disk_write_time_seconds_total{service=~\"$service\"}[5m]) / rate(node_disk_writes_completed_total{service=~\"$service\"}[5m])",
          "legendFormat": "{{service}} / {{device}}",
          "refId": "A"
        }
