{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    }
  ],
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "stat",
      "title": "Exporters Up",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "kvo-prometheus"
      },
      "targets": [
        {
          "expr": "count(max by (namespace, service, instance) (up{namespace=~\"$namespace\", service=~\"$service\", service=~\".*-metrics\"}) == 1)",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Exporters Down",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "kvo-prometheus"
      },
      "targets": [
        {
          "expr": "count(max by (namespace, service, instance) (up{namespace=~\"$namespace\", service=~\"$service\", service=~\".*-metrics\"}) == 0)",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "type": "table",
      "title": "Exporter Reachability by VM",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "kvo-prometheus"
      },
      "targets": [
        {
          "expr": "max by (namespace, service, instance) (up{namespace=~\"$namespace\", service=~\"$service\", service=~\".*-metrics\"})",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value": "up"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "up"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": 1,
                    "options": {
                      "0": {
                        "text": "DOWN",
                        "color": "red"
                      },
                      "1": {
                        "text": "UP",
                        "color": "green"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Guest CPU Utilization %",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "kvo-prometheus"
      },
      "targets": [
        {
          "expr": "100 - (avg by (instance, service, namespace) (rate(node_cpu_seconds_total{mode=\"idle\", namespace=~\"$namespace\", service=~\"$service\", service=~\".*-metrics\"}[5m])) * 100)",
          "legendFormat": "{{namespace}} / {{service}} / linux",
          "refId": "A"
        },
        {
          "expr": "100 - (avg by (instance, service, namespace) (rate(windows_cpu_time_total{mode=\"idle\", namespace=~\"$namespace\", service=~\"$service\", service=~\".*-metrics\"}[5m])) * 100)",
          "legendFormat": "{{namespace}} / {{service}} / windows",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Guest Memory Used %",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "kvo-prometheus"
      },
      "targets": [
        {
          "expr": "100 * (1 - (node_memory_MemAvailable_bytes{namespace=~\"$namespace\", service=~\"$service\", service=~\".*-metrics\"} / node_memory_MemTotal_bytes{namespace=~\"$namespace\", service=~\"$service\", service=~\".*-metrics\"}))",
          "legendFormat": "{{namespace}} / {{service}} / linux",
          "refId": "A"
        },
        {
          "expr": "100 * (1 - (windows_os_physical_memory_free_bytes{namespace=~\"$namespace\", service=~\"$service\", service=~\".*-metrics\"} / windows_cs_physical_memory_bytes{namespace=~\"$namespace\", service=~\"$service\", service=~\".*-metrics\"}))",
          "legendFormat": "{{namespace}} / {{service}} / windows",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Guest Network Receive (bytes/s)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "kvo-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (namespace, service) (rate(node_network_receive_bytes_total{device!~\"lo|docker.*|veth.*|cni.*|tap.*\", namespace=~\"$namespace\", service=~\"$service\", service=~\".*-metrics\"}[5m]))",
          "legendFormat": "{{namespace}} / {{service}} / linux",
          "refId": "A"
        },
        {
          "expr": "sum by (namespace, service) (rate(windows_net_bytes_received_total{namespace=~\"$namespace\", service=~\"$service\", service=~\".*-metrics\"}[5m]))",
          "legendFormat": "{{namespace}} / {{service}} / windows",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Guest Network Transmit (bytes/s)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "kvo-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (namespace, service) (rate(node_network_transmit_bytes_total{device!~\"lo|docker.*|veth.*|cni.*|tap.*\", namespace=~\"$namespace\", service=~\"$service\", service=~\".*-metrics\"}[5m]))",
          "legendFormat": "{{namespace}} / {{service}} / linux",
          "refId": "A"
        },
        {
          "expr": "sum by (namespace, service) (rate(windows_net_bytes_sent_total{namespace=~\"$namespace\", service=~\"$service\", service=~\".*-metrics\"}[5m]))",
          "legendFormat": "{{namespace}} / {{service}} / windows",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Linux Filesystem Used % (non-temporary)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "kvo-prometheus"
      },
      "targets": [
        {
          "expr": "100 * (1 - (node_filesystem_avail_bytes{fstype!~\"tmpfs|devtmpfs|overlay|squashfs\", mountpoint!~\"/run.*|/var/lib/kubelet.*\", namespace=~\"$namespace\", service=~\"$service\", service=~\".*-metrics\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|devtmpfs|overlay|squashfs\", mountpoint!~\"/run.*|/var/lib/kubelet.*\", namespace=~\"$namespace\", service=~\"$service\", service=~\".*-metrics\"}))",
          "legendFormat": "{{namespace}} / {{service}} / {{mountpoint}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Windows Logical Disk Used %",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "kvo-prometheus"
      },
      "targets": [
        {
          "expr": "100 * (1 - (windows_logical_disk_free_bytes{volume!~\"HarddiskVolume.*\", namespace=~\"$namespace\", service=~\"$service\", service=~\".*-metrics\"} / windows_logical_disk_size_bytes{volume!~\"HarddiskVolume.*\", namespace=~\"$namespace\", service=~\"$service\", service=~\".*-metrics\"}))",
          "legendFormat": "{{namespace}} / {{service}} / {{volume}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
