    {
      "type": "table",
      "title": "Top 15 CPU Consumers - Guest OS",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 60
      },
      "datasource": {
        "type": "prometheus",
        "uid": "kvo-prometheus"
      },
      "targets": [
        {
          "expr": "topk(15, 100 - (avg by (namespace, service) (rate(node_cpu_seconds_total{mode=\"idle\", namespace=~\"$namespace\", service=~\"$service\", service=~\".*-metrics\"}[5m])) * 100))",
          "refId": "A",
          "format": "table",
          "instant": true
        },
        {
          "expr": "topk(15, 100 - (avg by (namespace, service) (rate(windows_cpu_time_total{mode=\"idle\", namespace=~\"$namespace\", service=~\"$service\", service=~\".*-metrics\"}[5m])) * 100))",
          "refId": "B",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "description": "Guest CPU from node_exporter/windows_exporter. This is inside-the-VM visibility, not KubeVirt host-side CPU only.",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value": "value"
            }
          }
        }
      ],
      "id": 1
    },
