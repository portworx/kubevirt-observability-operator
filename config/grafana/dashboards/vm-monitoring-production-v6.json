      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "kvo-prometheus"
      },
      "targets": [
        {
          "expr": "node_load5{namespace=~\"$namespace\", service=~\"$service\", service=~\".*-metrics\"}",
          "legendFormat": "{{namespace}} / {{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Linux Disk Throughput (bytes/s)",
      "gridPos": {
