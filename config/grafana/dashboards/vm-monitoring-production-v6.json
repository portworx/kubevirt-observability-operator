          "format": "table",
          "instant": true
        },
        {
          "expr": "topk(20, predict_linear(windows_logical_disk_free_bytes{volume!~\"HarddiskVolume.*\", namespace=~\"$namespace\", service=~\"$service\", service=~\".*-metrics\"}[24h], 7*24*3600) < 0)",
          "refId": "B",
          "format": "table",
          "instant": true
